---
import ThemeToggle from './ThemeToggle.astro';

const enlaces = [
	{ href: '#proyectos', texto: 'Proyectos' },
	{ href: '#bases-de-datos', texto: 'Bases de datos' },
	{ href: '#experiencia', texto: 'Experiencia' },
	{ href: '#sobre-mi', texto: 'Sobre mí' },
	{ href: '#contacto', texto: 'Contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md">
	<div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
		<a href="/" class="font-display text-subtitle font-bold">Berni</a>
		<!-- En móvil el menú baja a su propia fila y se desliza en horizontal para no ocupar media pantalla -->
		<nav aria-label="Principal" class="order-last -mx-4 w-[calc(100%+2rem)] overflow-x-auto px-4 sm:order-none sm:mx-0 sm:w-auto sm:px-0">
			<ul class="flex gap-4 whitespace-nowrap text-small text-muted">
				{enlaces.map(({ href, texto }) => (
					<li><a href={href}>{texto}</a></li>
				))}
			</ul>
		</nav>
		<ThemeToggle />
		<!-- Fase 4: selector ES / EN -->
	</div>
</header>
