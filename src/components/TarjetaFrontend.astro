---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Etiquetas from './Etiquetas.astro';

interface Props {
	proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { titulo, resumen, portada, portadaAlt, tecnologias, demo, repo, destacado } = proyecto.data;
---

<!-- El título es un enlace "estirado" que cubre toda la tarjeta; los otros enlaces quedan por encima -->
<article class:list={['group relative overflow-hidden rounded-2xl border border-border bg-surface transition-colors hover:border-accent/60', destacado && 'sm:col-span-2']}>
	<Image
		src={portada}
		alt={portadaAlt}
		widths={[400, 800, 1200]}
		sizes={destacado ? '(min-width: 768px) 736px, 100vw' : '(min-width: 768px) 360px, 100vw'}
		class="aspect-video w-full object-cover"
	/>
	<div class="flex flex-col gap-4 p-5">
		<div>
			<h3>
				<a href={`/proyectos/${proyecto.id}/`} class="after:absolute after:inset-0 hover:no-underline">{titulo}</a>
			</h3>
			<p class="mt-2 text-muted">{resumen}</p>
		</div>
		<Etiquetas tecnologias={tecnologias} />
		<p class="relative z-10 flex gap-4 text-small font-medium">
			{demo && <a href={demo}>Ver demo</a>}
			<a href={repo}>Código</a>
		</p>
	</div>
</article>
