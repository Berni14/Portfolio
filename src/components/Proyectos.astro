---
import { getCollection } from 'astro:content';
import Seccion from './Seccion.astro';
import TarjetaFrontend from './TarjetaFrontend.astro';

const proyectos = (await getCollection('proyectos', ({ data }) => data.tipo === 'frontend'))
	.sort((a, b) => a.data.orden - b.data.orden);
---

<Seccion id="proyectos" titulo="Proyectos">
	<div class="grid gap-6 sm:grid-cols-2">
		{proyectos.map((proyecto) => <TarjetaFrontend proyecto={proyecto} />)}
	</div>
</Seccion>
