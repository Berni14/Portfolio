---
import Seccion from './Seccion.astro';

const experiencia = [
	{
		puesto: 'Desarrollador web freelance',
		lugar: 'Proyectos propios',
		fechas: '2024 – actualidad',
		descripcion: 'Diseño y desarrollo de aplicaciones web de principio a fin, desde la base de datos hasta la interfaz y el despliegue.',
	},
	{
		puesto: 'Desarrollador principal',
		lugar: 'Robot ASCII Challenge · en equipo',
		fechas: '2026',
		descripcion:
			'Participante en el concurso Robot ASCII Challenge como desarrollador principal del equipo: me encargué de la programación del robot con el que teníamos que superar una serie de pruebas.',
	},
];

const formacion = [
	{
		titulo: 'Desarrollo de Aplicaciones Web (DAW)',
		lugar: 'Ciclo formativo de grado superior',
		fechas: 'En curso',
	},
];

// Cursos de Cisco Networking Academy, del más reciente al más antiguo
const cursos = [
	{ titulo: 'Data Science Essentials with Python', fechas: '2026' },
	{ titulo: 'Networking Basics', fechas: '2026' },
	{ titulo: 'JavaScript Essentials 2', fechas: '2026' },
	{ titulo: 'Introduction to Cybersecurity', fechas: 'Curso 25/26 · CES GMQ' },
	{ titulo: 'Linux Unhatched', fechas: 'Curso 25/26 · CES GMQ' },
	{ titulo: 'JavaScript Essentials 1', fechas: '2025' },
];
---

<Seccion id="experiencia" titulo="Experiencia">
	<ol class="space-y-8 border-l border-border pl-6">
		{experiencia.map(({ puesto, lugar, fechas, descripcion }) => (
			<li class="relative">
				<span class="absolute top-2 -left-[calc(1.5rem+3.5px)] size-2 rounded-full bg-accent" aria-hidden="true"></span>
				<h3>{puesto}</h3>
				<p class="text-small text-muted">{lugar} · {fechas}</p>
				<p class="mt-2 max-w-prose">{descripcion}</p>
			</li>
		))}
	</ol>

	<h3 class="mt-12 mb-4">Formación</h3>
	<ul class="space-y-4">
		{formacion.map(({ titulo, lugar, fechas }) => (
			<li>
				<p class="font-medium">{titulo}</p>
				<p class="text-small text-muted">{lugar} · {fechas}</p>
			</li>
		))}
	</ul>

	<h3 class="mt-12 mb-1">Cursos</h3>
	<p class="mb-4 text-small text-muted">Cisco Networking Academy</p>
	<ul class="grid gap-4 sm:grid-cols-2">
		{cursos.map(({ titulo, fechas }) => (
			<li>
				<p class="font-medium">{titulo}</p>
				<p class="text-small text-muted">{fechas}</p>
			</li>
		))}
	</ul>
</Seccion>
