---
interface Props {
	demo?: string;
	repo?: string;
	enlaces?: { texto: string; url: string }[];
}

const { demo, repo, enlaces = [] } = Astro.props;
const base = 'inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-small font-medium hover:no-underline transition-colors';
const secundario = 'border border-border text-fg hover:border-accent hover:text-fg';
---

{(demo || repo || enlaces.length > 0) && (
	<p class="relative z-10 flex flex-wrap gap-3">
		{demo && (
			<a href={demo} target="_blank" rel="noopener" class:list={[base, 'bg-accent text-accent-fg hover:text-accent-fg hover:opacity-90']}>
				Ver demo <span aria-hidden="true">↗</span>
				<span class="sr-only">(se abre en otra pestaña)</span>
			</a>
		)}
		{repo && (
			<a href={repo} target="_blank" rel="noopener" class:list={[base, secundario]}>
				{enlaces.length > 0 ? 'Código de la web' : 'Código'} <span aria-hidden="true">↗</span>
				<span class="sr-only">(se abre en otra pestaña)</span>
			</a>
		)}
		{enlaces.map(({ texto, url }) => (
			<a href={url} target="_blank" rel="noopener" class:list={[base, secundario]}>
				{texto} <span aria-hidden="true">↗</span>
				<span class="sr-only">(se abre en otra pestaña)</span>
			</a>
		))}
	</p>
)}
