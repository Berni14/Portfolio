---
// Tres estados: sistema → claro → oscuro. El texto visible se actualiza desde el script.
---

<button
	type="button"
	id="theme-toggle"
	class="inline-flex items-center gap-2 rounded-full border border-border px-3 py-1 text-small text-muted hover:border-accent hover:text-fg"
>
	<span aria-hidden="true" class="size-2 rounded-full bg-accent"></span>
	<span id="theme-toggle-label">Tema: sistema</span>
</button>

<script>
	type Pref = 'system' | 'light' | 'dark';

	const order: Pref[] = ['system', 'light', 'dark'];
	const names: Record<Pref, string> = { system: 'sistema', light: 'claro', dark: 'oscuro' };
	const root = document.documentElement;
	const media = matchMedia('(prefers-color-scheme: dark)');
	const button = document.getElementById('theme-toggle')!;
	const label = document.getElementById('theme-toggle-label')!;

	function apply(pref: Pref) {
		const dark = pref === 'dark' || (pref === 'system' && media.matches);
		root.dataset.theme = dark ? 'dark' : 'light';
		root.dataset.themePref = pref;
		label.textContent = `Tema: ${names[pref]}`;
		button.setAttribute('aria-label', `Cambiar tema (ahora: ${names[pref]})`);
	}

	function current(): Pref {
		const pref = root.dataset.themePref as Pref;
		return order.includes(pref) ? pref : 'system';
	}

	button.addEventListener('click', () => {
		const next = order[(order.indexOf(current()) + 1) % order.length];
		try {
			localStorage.setItem('theme', next);
		} catch {}
		apply(next);
	});

	// Si el usuario eligió "sistema", seguir los cambios del sistema operativo en vivo
	media.addEventListener('change', () => {
		if (current() === 'system') apply('system');
	});

	apply(current());
</script>
